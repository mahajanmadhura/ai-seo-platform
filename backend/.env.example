DB_ENGINE=postgres
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

DEBUG=True
# Required for email features to work locally
BREVO_API_KEY=your_api_key_here
EMAIL_HOST_USER=your_brevo_email@example.com
EMAIL_HOST_PASSWORD=your_smtp_password_here
DEFAULT_FROM_EMAIL=your_verified_sender@example.com
GROQ_API_KEY=your_api_key_here
PAGESPEED_API_KEY=your_pagespeed_api_key_here_from_google_console
