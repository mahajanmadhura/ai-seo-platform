# ==============================================================================
# ATHENURA AI SEO AUDITOR PLATFORM - BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# 2. APPLICATION & DOMAIN URLS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
DOMAIN_NAME=Athenura SEO Ecosystem

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# Set USE_SQLITE=True for local development (uses local db.sqlite3).
# Set USE_SQLITE=False to connect to a PostgreSQL instance.
# ------------------------------------------------------------------------------
USE_SQLITE=True
DB_ENGINE=postgres
DB_NAME=seo_auditor_db
DB_USER=seo_user
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. EMAIL / BREVO (SENDINBLUE) SMTP CONFIGURATION
# Required for account verification, password resets, and audit notifications.
# ------------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=notifications@yourdomain.com
EMAIL_HOST_USER=your_brevo_account_email@example.com
EMAIL_HOST_PASSWORD=your_brevo_smtp_master_key_here
BREVO_API_KEY=your_brevo_api_v3_key_here

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (RAZORPAY)
# Required for buying credits and client billing transactions.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 6. AI RECOMMENDATIONS & AUDIT APIS (GROQ & PAGESPEED)
# Required for technical SEO crawl insights, AI suggestions, and CWV audit scores.
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
PAGESPEED_API_KEY=your_google_pagespeed_api_key_from_google_cloud_console

# ------------------------------------------------------------------------------
# 7. REDIS & CELERY TASK QUEUE
# Used for background crawling, async audits, and Django Channels websockets.
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
