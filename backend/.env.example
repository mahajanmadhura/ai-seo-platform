# ==============================================================================
# ATHENURA AI SEO AUDITOR PLATFORM - BACKEND CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DJANGO CORE & SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=django-insecure-change-this-to-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# ------------------------------------------------------------------------------
# 2. APPLICATION & DOMAIN URLS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
DOMAIN_NAME=Athenura SEO Ecosystem

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL & RENDER)
# Option A: Single DATABASE_URL (Standard on Render / Railway / Heroku)
# Option B: Individual connection parameters
# Set USE_SQLITE=True for local development (uses local db.sqlite3).
# ------------------------------------------------------------------------------
USE_SQLITE=False
DATABASE_URL=postgresql://ai_seo_user:your_password@dpg-da24algu01pc73dqtk2g-a/ai_seo_db_kz3j
DB_ENGINE=postgres
DB_NAME=ai_seo_db_kz3j
DB_USER=ai_seo_user
DB_PASSWORD=your_db_password_here
DB_HOST=dpg-da24algu01pc73dqtk2g-a
DB_PORT=5432

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY TASK QUEUE (RENDER / LOCAL)
# Option A: REDIS_URL (Internal connection URL on Render)
# Option B: Individual REDIS_HOST and REDIS_PORT
# ------------------------------------------------------------------------------
REDIS_URL=redis://red-da24bcn40ujc73956lhg:6379
REDIS_HOST=red-da24bcn40ujc73956lhg
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 5. EMAIL / BREVO (SENDINBLUE) SMTP CONFIGURATION
# Required for account verification, password resets, and audit notifications.
# ------------------------------------------------------------------------------
DEFAULT_FROM_EMAIL=notifications@yourdomain.com
EMAIL_HOST_USER=your_brevo_account_email@example.com
EMAIL_HOST_PASSWORD=your_brevo_smtp_master_key_here
BREVO_API_KEY=your_brevo_api_v3_key_here

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAY (RAZORPAY)
# Required for buying credits and client billing transactions.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 7. AI RECOMMENDATIONS & AUDIT APIS (GROQ & PAGESPEED)
# Required for technical SEO crawl insights, AI suggestions, and CWV audit scores.
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
PAGESPEED_API_KEY=your_google_pagespeed_api_key_from_google_cloud_console
